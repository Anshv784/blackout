# Copy to .env to override the defaults. Everything here is optional.

# Solana RPC for the base layer. Default: MagicBlock's public devnet RPC.
# Anything set here ships inside the built site, so use a key restricted to your domain.
# VITE_BASE_RPC=https://rpc.magicblock.app/devnet

# Your own deployment of the program (default: the address in src/idl/blackout.json).
# VITE_PROGRAM_ID=

# "mainnet" switches the TEE endpoints and the program to mainnet (needs VITE_BASE_RPC too).
# VITE_CLUSTER=devnet
