// BLACKOUT on Cloudflare: an assets-only Worker serving the built app (app/dist).
// Deployed by .github/workflows/cloudflare.yml on every push to main (same build as Vercel).
{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "blackout",
  "compatibility_date": "2026-11-04",
  // the app is static; worker/index.ts only answers /api/* (quest claims)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // quest claims (worker/index.ts); ADMIN_TOKEN is a secret (.dev.vars locally)
  "kv_namespaces": [{ "binding": "CLAIMS", "id": "6463838432864223b557bd9a6368ed54" }],
  // the game's own domain (blackout.anshverma.tech stays on Vercel, untouched)
  "routes": [
    { "pattern": "playblackout.fun", "custom_domain": true },
    { "pattern": "www.playblackout.fun", "custom_domain": true },
    // blackout.anshverma.tech arrives as a Cloudflare for SaaS custom hostname on playblackout.fun
    { "pattern": "blackout.anshverma.tech/*", "zone_name": "playblackout.fun" }
  ],
  // keep the workers.dev address working too
  "workers_dev": true,
  "observability": { "enabled": true }
}
